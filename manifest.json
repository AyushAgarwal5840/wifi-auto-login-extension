{
  "manifest_version": 3,
  "name": "Institute WiFi Auto Login Pro",
  "version": "2.1",
  "description": "Automatic login and reconnect for institute WiFi portal",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://172.22.2.6/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://172.22.2.6/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
